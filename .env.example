# AeroTwin AI Configuration Example
# Copy this file to .env and adjust as needed for your local environment.

# ==============================================================================
# Server Configuration
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Telemetry & Simulation Parameters
# ==============================================================================
TELEMETRY_SAMPLE_RATE_HZ=10
SIMULATION_DT_SEC=0.1
DEFAULT_MISSION_PROFILE=standard_surveillance
DEFAULT_ENGINE_MODEL=ROTAX_914_915_SIM

# ==============================================================================
# Storage & Persistence
# ==============================================================================
SQLITE_DB_PATH=data/aerotwin.db
PARQUET_DATA_DIR=data/telemetry_parquet

# ==============================================================================
# Machine Learning & Explainability
# ==============================================================================
ANOMALY_DETECTOR_PATH=models/anomaly_detector.joblib
FAULT_CLASSIFIER_PATH=models/fault_classifier.joblib
SHAP_BACKGROUND_SAMPLES=100
SHAP_INFERENCE_INTERVAL_SEC=1.0

# ==============================================================================
# Security & Hardware Integration Stubs
# ==============================================================================
CAN_CHANNEL=vcan0
CAN_INTERFACE=virtual
API_KEY_SECRET=change_this_to_a_secure_token_in_production
